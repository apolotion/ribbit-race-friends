{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ribbit-race-friends",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*","/ws"]},
  "durable_objects": {"bindings":[
    {"name":"HUB", "class_name":"FriendsHub"},
    {"name":"ROOMS", "class_name":"FriendsRoom"}
  ]},
  "migrations": [{"tag":"friends-v1", "new_sqlite_classes":["FriendsHub","FriendsRoom"]}],
  "vars": {"MAX_ACCOUNTS":"500", "ALLOW_REGISTRATION":"true"},
  "observability": {"enabled":false}
}
